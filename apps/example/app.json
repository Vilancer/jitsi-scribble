{
  "expo": {
    "name": "jitsi-scribble",
    "slug": "jitsi-scribble-example",
    "scheme": "jitsi-scribble-example",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.vilancer.jitsiscribbleexample",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSLocalNetworkUsageDescription": "jitsi-scribble connects to a Jitsi server on your local network for testing.",
        "RTCAppGroupIdentifier": "group.com.vilancer.jitsiscribbleexample",
        "RTCScreenSharingExtension": "com.vilancer.jitsiscribbleexample.broadcast"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.vilancer.jitsiscribbleexample"
        ]
      }
    },
    "android": {
      "package": "com.vilancer.jitsiscribbleexample",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "jitsi-scribble uses the camera only if you turn it on in a call.",
          "microphonePermission": "jitsi-scribble uses the microphone only if you turn it on in a call."
        }
      ],
      "./plugins/withAndroidScreenShare",
      "@bacons/apple-targets",
      "./plugins/withIosPodDeploymentTarget",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "backgroundColor": "#000000"
  }
}
