<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- "Display over other apps": the floating bubble, toolbar and ink layer
       are TYPE_APPLICATION_OVERLAY windows. Installing this package adds the
       permission to the host app; the user still has to grant it in system
       settings (requestPermission() opens that screen). -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
</manifest>
