{
  "name": "@vilancer/scribble-overlay",
  "version": "0.2.3",
  "description": "Floating FaceTime-style drawing button that works outside your React Native app (Android), for @vilancer/scribble annotation sessions.",
  "type": "module",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/module/index.js",
  "types": "./dist/typescript/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/typescript/index.d.ts",
      "react-native": "./dist/module/index.js",
      "import": "./dist/module/index.js",
      "default": "./dist/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "android/build.gradle",
    "android/src",
    "expo-module.config.json",
    "!**/*.tsbuildinfo",
    "!**/*.spec.*"
  ],
  "keywords": [
    "react-native",
    "expo",
    "jitsi",
    "annotation",
    "overlay",
    "screen-share",
    "drawing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vilancer/jitsi-scribble.git",
    "directory": "packages/native-overlay"
  },
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      "module",
      "commonjs",
      [
        "typescript",
        {
          "project": "tsconfig.lib.json"
        }
      ]
    ],
    "exclude": "{**/*.spec.*,**/*.test.*}"
  },
  "dependencies": {
    "@vilancer/scribble-protocol": "workspace:*"
  },
  "peerDependencies": {
    "@vilancer/scribble": "workspace:^",
    "expo": ">=52.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.79.0"
  },
  "devDependencies": {
    "@vilancer/scribble": "workspace:*",
    "expo": "55.0.28",
    "react": "19.2.0",
    "react-native": "0.83.4",
    "react-native-builder-bob": "0.43.0",
    "jest": "29.7.0",
    "jest-expo": "55.0.20",
    "@types/jest": "29.5.14"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "rm -rf dist && bob build && rm -f dist/tsconfig.lib.tsbuildinfo",
          "cwd": "packages/native-overlay"
        },
        "outputs": [
          "{projectRoot}/dist"
        ],
        "dependsOn": [
          "^build"
        ]
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "jest",
          "cwd": "packages/native-overlay"
        }
      }
    }
  }
}
