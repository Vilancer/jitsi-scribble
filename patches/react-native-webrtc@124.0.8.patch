@@ -75,7 +83,20 @@
 }
 
 - (void)close {
-    [self performSelector:@selector(unscheduleStreams) onThread:self.networkThread withObject:nil waitUntilDone:true];
+    // GENIUS PATCH: hop onto the network thread only if it is actually running.
+    // For a broadcast that never connected (every cancelled consent sheet) the
+    // thread was never started: the waitUntilDone:YES hop then blocks forever —
+    // and the caller is WebRTCModule's serial workerQueue (its methodQueue), so
+    // one cancelled screen-share attempt wedged every later WebRTC native call
+    // and, via the RCT_EXPORT_BLOCKING_SYNCHRONOUS methods, froze the JS thread.
+    // With no thread running nothing was ever scheduled on its run loop, so
+    // closing the streams directly is correct and sufficient.
+    if (self.threadStarted && !self.networkThread.isFinished) {
+        [self performSelector:@selector(unscheduleStreams)
+                     onThread:self.networkThread
+                   withObject:nil
+                waitUntilDone:true];
+    }
 
     self.inputStream.delegate = nil;
     self.outputStream.delegate = nil;
