diff --git a/android/src/main/java/com/oney/WebRTCModule/ScreenCaptureController.java b/android/src/main/java/com/oney/WebRTCModule/ScreenCaptureController.java
index 554739d..8009424 100644
--- a/android/src/main/java/com/oney/WebRTCModule/ScreenCaptureController.java
+++ b/android/src/main/java/com/oney/WebRTCModule/ScreenCaptureController.java
@@ -76,11 +76,19 @@ public class ScreenCaptureController extends AbstractVideoCaptureController {
                     public void onStop() {
                         Log.w(TAG, "Media projection stopped.");
                         orientationListener.disable();
-                        stopCapture();
 
-                        if (capturerEventsListener != null) {
-                            capturerEventsListener.onCapturerEnded();
-                        }
+                        // Pivot to the executor thread: stopCapture() blocks until the capture
+                        // thread joins, and running it synchronously on the MediaProjection
+                        // callback thread can deadlock (same reason changeCaptureFormat above
+                        // pivots). Keep the stop -> onCapturerEnded order so the JS 'ended'
+                        // event still fires after capture is actually down.
+                        ThreadUtils.runOnExecutor(() -> {
+                            stopCapture();
+
+                            if (capturerEventsListener != null) {
+                                capturerEventsListener.onCapturerEnded();
+                            }
+                        });
                     }
                 });
 
diff --git a/ios/RCTWebRTC/ScreenCaptureController.m b/ios/RCTWebRTC/ScreenCaptureController.m
index caab33c..8eb462a 100644
--- a/ios/RCTWebRTC/ScreenCaptureController.m
+++ b/ios/RCTWebRTC/ScreenCaptureController.m
@@ -46,6 +46,17 @@ NSString *const kRTCAppGroupIdentifier = @"RTCAppGroupIdentifier";
 
     self.capturer.eventsDelegate = self;
     NSString *socketFilePath = [self filePathForApplicationGroupIdentifier:self.appGroupIdentifier];
+    // containerURLForSecurityApplicationGroupIdentifier: returns nil when the app is
+    // NOT provisioned with this App Group (entitlement/portal missing). Passing the
+    // nil-derived path into SocketConnection crashes in strncpy(NULL). Bail out with
+    // a log instead — the JS side detects the never-starting share via its stats
+    // watchdog and cleans up gracefully.
+    if (socketFilePath == nil || socketFilePath.length == 0) {
+        NSLog(@"[ScreenCaptureController] App Group container unavailable for %@ — "
+              @"check the App Groups entitlement/provisioning; screen share cannot start.",
+              self.appGroupIdentifier);
+        return;
+    }
     SocketConnection *connection = [[SocketConnection alloc] initWithFilePath:socketFilePath];
     [self.capturer startCaptureWithConnection:connection];
 }
